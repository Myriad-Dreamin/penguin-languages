{
  "name": "penguin-languages",
  "private": true,
  "type": "module",
  "description": "Syntax-highlighting plugins for PenguinHarness, one language each.",
  "license": "MIT",
  "scripts": {
    "gen:ifaces": "pnpm -r gen:ifaces",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@prismshadow/penguin-core": ">=0.2.14",
    "@shikijs/langs": "4.3.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.6"
  }
}
